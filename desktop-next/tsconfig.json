{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": { "jsdom": ["./node_modules/@types/jsdom/index.d.ts"] },
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["electron", "src", "shared"]
}
